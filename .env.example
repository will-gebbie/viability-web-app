SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
CELLPOSE_MODEL=/absolute/path/to/cellpose/model
SERVICE_TOKEN=

# Point these at remote deployments of the analysis services.
# Unset means the local compose containers.
# COUNTER_URL=https://counter.example.com/count
# STRAIN_URL=https://strain.example.com/strain_comp
# MICRO_URL=https://micro.example.com/micro

# Service Timeouts - unset during local
# COUNTER_TIMEOUT=180
# COUNTER_SERVER_TIMEOUT=300
# STRAIN_TIMEOUT=600
# STRAIN_SERVER_TIMEOUT=900
# MICRO_TIMEOUT=600
# MICRO_SERVER_TIMEOUT=900


# The portal's own gunicorn --timeout. Keep it ABOVE the largest *_TIMEOUT above,
# or the worker is killed before the analysis service answers.
# WEB_SERVER_TIMEOUT=950


# SMTP for password-reset / invite emails. Set EMAIL_HOST to switch off the
# console backend. EMAIL_PORT defaults to 587, EMAIL_USE_TLS to True.
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=LabPortal <noreply@example.com>
